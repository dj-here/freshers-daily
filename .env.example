# FreshersDaily Environment Configuration

# Application
APP_NAME=FreshersDaily
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars

# Database (PostgreSQL with pgvector for prod; SQLite async fallback in dev/test)
DATABASE_URL=postgresql+asyncpg://freshers:freshers123@localhost:5432/freshers_daily
# Fallback local sqlite for quick start:
# DATABASE_URL=sqlite+aiosqlite:///./freshers_daily.db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration
# Supported: anthropic, openai, dummy (for deterministic offline testing)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500
LLM_BUDGET_LIMIT_USD_PER_DAY=10.0

# Ingestion & Scraping
USER_AGENT=FreshersDailyBot/1.0 (+https://freshersdaily.in/bot; contact@freshersdaily.in)
RATE_LIMIT_PER_DOMAIN_SECONDS=1.0
HTTP_TIMEOUT_SECONDS=15.0
MAX_REDIRECTS=5

# Aggregator API Keys (Optional behind feature flags)
FEATURE_FLAG_ADZUNA=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Delivery Channels
# Email (Resend or AWS SES)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
FROM_EMAIL=digest@freshersdaily.in

# Telegram Bot (Optional)
FEATURE_FLAG_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID_2026=
TELEGRAM_CHANNEL_ID_2027=
TELEGRAM_CHANNEL_ID_2028=

# Admin Authentication
ADMIN_API_KEY=adminkey-dev-supersecret-freshersdaily-2026

# Scheduler
SCHEDULER_ENABLED=true
INGESTION_CRON="0 2 * * *"       # 02:00 IST
VERIFICATION_CRON="0 3 * * *"    # 03:00 IST
RANKING_CRON="30 5 * * *"        # 05:30 IST
REVERIFICATION_CRON="45 5 * * *" # 05:45 IST
PUBLISH_CRON="0 6 * * *"         # 06:00 IST
TIMEZONE=Asia/Kolkata
